{
  "name": "babyguide",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test --grep-invert \"child mode survives back/reload and blocks parents until adult gate|child narrow layouts and swipe; rejected localStorage writes never claim success|mic denial, absent API, transient repeat cleanup and navigation during recording\"",
    "typecheck": "tsc --noEmit",
    "test:weather:live": "playwright test --config playwright.live.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
