{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "babyguide-family",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "secrets": {
    "required": ["FISH_AUDIO_API_KEY", "FISH_AUDIO_REFERENCE_ID"]
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
