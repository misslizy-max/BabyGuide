{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "babyguide",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
